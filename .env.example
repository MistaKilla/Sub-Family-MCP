# Sub-Family environment variables.
#
# Copy this file to `.env` in the directory that holds family.yaml
# (default: ~/.config/sub-family/.env) or export the variables in the shell
# that launches Claude Code / `sub-family-mcp`. Never commit a filled-in copy.

# API key for the default DeepSeek "big_brother" member. Only needed when your
# family.yaml references DEEPSEEK_API_KEY; local-only families can leave it empty.
DEEPSEEK_API_KEY=

# Optional: absolute path to family.yaml.
# Default: ~/.config/sub-family/family.yaml (XDG-aware; %APPDATA% on Windows).
# SUB_FAMILY_CONFIG=/absolute/path/to/family.yaml

# Optional: directory for mutable state, including sessions.db.
# Default: ~/.local/share/sub-family (%LOCALAPPDATA%\sub-family on Windows).
# SUB_FAMILY_DATA_DIR=/absolute/path/to/data

# Optional: DEBUG, INFO, WARNING, or ERROR. Logs go to stderr only, because
# stdout carries the MCP stdio protocol.
SUB_FAMILY_LOG_LEVEL=WARNING
